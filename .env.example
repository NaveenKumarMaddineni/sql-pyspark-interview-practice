# Copy this file to .env and fill in your values:   cp .env.example .env
# .env is in .gitignore, so your settings never go to GitHub.

# ---- BigQuery ----
BQ_PROJECT=your-gcp-project-id      # the project ID from the GCP console
BQ_DATASET=shield                   # dataset (a folder for tables) that holds the 7 tables
BQ_LOCATION=US                      # where the dataset lives, e.g. US, EU, europe-west2
# Optional: use a named gcloud configuration instead of application-default login
# BQ_GCLOUD_CONFIG=my-config

# ---- Oracle ----
ORACLE_DSN=localhost:1521/FREEPDB1  # host:port/service_name
ORACLE_USER=shield
# Password: pick ONE of these. ORACLE_PASSWORD is easiest; Keychain is safer on a Mac.
ORACLE_PASSWORD=change-me
# ORACLE_KEYCHAIN_ITEM=oracle-shield   # macOS Keychain item name (service and account)
